#include <stdio.h>
#include <unistd.h>

#define MAX 10

char *fila[MAX];
int posx = -1;
int *ptr_posx = &posx;


void enqueue(char nome[]) {
	if (*ptr_posx == MAX) {
		printf("ERRO: FILA CHEIA!\n");
	} else {
		*ptr_posx += 1;
		fila[*ptr_posx] = nome;
	}
}


void dequeue() {
	if (*ptr_posx == -1) {
		printf("ERRO: FILA VAZIA!\n");
	} else {
		for (int i = 0; i < *ptr_posx; i++) {
			fila[i] = fila[i+1];
		}
		*ptr_posx -= 1;
	}
}


char inicioFila() {
	if (*ptr_posx == -1) {
		printf("ERRO: FILA VAZIA!\n");
	} else {
		return *fila[0];
	}
}


void mostraFila() {
	if (*ptr_posx == -1) {
		printf("ERRO: FILA VAZIA!\n");
	} else {
		for (int i = 0; i <= *ptr_posx; i++) {
			printf("%s\n", fila[i]);
			printf("%d\n", i);
		}
	}
}


int main() {
	int opt = 0;

	do {
		printf("\n--------------- BANCO ---------------\n\n");
		printf("[1] Adicionar Cliente   [2] Atender Proximo\n");
		printf("[3] Mostrar Fila        [0] Sair\n");
		printf("Opção: ");
		scanf("%d", &opt);

		switch (opt) {
			case 0:
				break;

			case 1:
				char nome[20];
				printf("\n-------------------------\n");
				printf("Nome do Cliente: ");
				//getchar();
				//fgets(nome, sizeof(nome), stdin);
				scanf("%s", &nome);

				enqueue(nome);
				break;

			case 2:
				printf("\n-------------------------\n");
				if (*ptr_posx == -1) {
					printf("Fila Vazia!\n");
				} else {
					printf("Atendendo %s...\n", inicioFila());
				}
				dequeue();
				//sleep(2);
				break;

			case 3:
				printf("\n-------------------------\n");
				printf("Fila Atual:\n");
				mostraFila();
				//sleep(2);
				break;

			default:
				printf("\n-------------------------\n");
				printf("Opção Invalida!");
				//sleep(2);
		}
	} while (opt != 0);

	return 0;
}
